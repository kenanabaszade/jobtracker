BOT_TOKEN=your_telegram_bot_token_here
# Optional: override default SQLite path (relative to project root)
# DATABASE_URL=sqlite+aiosqlite:///./data/jobtracker.db
# LinkedIn (optional). Base URL; location/geoId are merged for Baku by default.
# LINKEDIN_JOB_SEARCH_URL=https://www.linkedin.com/jobs/search/?keywords=developer
# LINKEDIN_LOCATION=Baku, Azerbaijan
# Leave empty to search globally: LINKEDIN_LOCATION=
# Optional: copy geoId from LinkedIn when you pick a city in the browser
# LINKEDIN_GEO_ID=
# Max distinct /add keywords used as separate LinkedIn searches per cycle (default 12)
# LINKEDIN_KEYWORD_CYCLE_LIMIT=12
LOG_LEVEL=INFO
# Scrape every N minutes (default 240 = 4 hours). Example for testing: SCRAPE_INTERVAL_MINUTES=2
SCRAPE_INTERVAL_MINUTES=240
# Set to true to run one scrape immediately when the bot starts
# SCRAPE_ON_STARTUP=true
